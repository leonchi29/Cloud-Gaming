# URL pública del backend desplegado en Railway (sin barra final)
BACKEND_URL=http://localhost:4000
# Debe coincidir con AGENT_TOKEN del backend
AGENT_TOKEN=cambia-este-token-seguro
# Ruta del ejecutable de Sunshine
SUNSHINE_PATH=C:\Program Files\Sunshine\sunshine.exe
# Intervalo de verificación de Sunshine (ms)
SUNSHINE_CHECK_INTERVAL_MS=15000
# Fotogramas por segundo del streaming
STREAM_FPS=8
